# Copy to .env and set the Neon connection string for the franchiseos project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
PORT=8080
# Optional. The key is read only by the Node server; never add it to frontend code or committed files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required to enable Academy authoring and approvals; keep server-side and out of the browser bundle.
ACADEMY_ADMIN_TOKEN=
# Optional request-cost estimate for server usage logs. Set this from your provider billing terms.
GEMINI_COST_PER_REQUEST_USD=
